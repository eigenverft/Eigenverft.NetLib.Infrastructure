<Project Sdk="Microsoft.NET.Sdk">

  <!-- Branding information -->
  <PropertyGroup>
    <Branding>Eigenverft</Branding>
  </PropertyGroup>

  <!-- General build settings: defines the output type and target frameworks -->
  <PropertyGroup>
    <!-- LTS-oriented public package targets. Compatible odd-numbered .NET consumers use the preceding LTS asset. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <!-- C# language features and debugging configuration -->
  <PropertyGroup>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Packaging and publish configuration -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <IsPublishable>false</IsPublishable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <!-- Versioning details -->
  <PropertyGroup>
    <VersionBuild>1</VersionBuild>
    <VersionMajor>0</VersionMajor>
    <VersionMinor>0</VersionMinor>
    <VersionRevision>0</VersionRevision>
    <AssemblyVersion>$(VersionBuild).$(VersionMajor).$(VersionMinor).$(VersionRevision)</AssemblyVersion>
    <Version>$(VersionBuild).$(VersionMajor).$(VersionMinor).$(VersionRevision)$(VersionSuffix)</Version>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>$(AssemblyName)</PackageId>
    <Authors>$(Branding)</Authors>
    <RepositoryUrl>https://github.com/eigenverft/$(AssemblyName)</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/eigenverft/$(AssemblyName)</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>evt-logo_on_all_standard_128x128.png</PackageIcon>
    <Description>Reusable .NET infrastructure primitives for Generic Host, configuration binding, IP/CIDR networking, executable-rooted directory layouts, reversible string transforms, machine binding, X.509 certificates, and bootstrap logging.</Description>
    <PackageTags>dotnet;infrastructure;configuration;options;networking;ip;cidr;filesystem;directories;hosting;logging;bootstrap-logging;transformations;encoding;machine-binding;certificates;x509;pfx;cryptography;utilities;eigenverft</PackageTags>
  </PropertyGroup>

  <!-- Company and copyright information -->
  <PropertyGroup>
    <Copyright>Copyright (c) 2026 $(Branding)</Copyright>
  </PropertyGroup>

  <!-- Package dependencies for net8.0 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <!-- Package dependencies for net10.0 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <!-- NuGet package content -->
  <ItemGroup>
    <None Include="../../../README.NUGET.md" Pack="true" PackagePath="README.md" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="/" Link="LICENSE" />
    <None Include="AddPackageFiles/evt-logo_on_all_standard_128x128.png" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
