<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <DebugType>embedded</DebugType>
    <DefineConstants>$(DefineConstants);TEST_NETSTANDARD_RELAY</DefineConstants>
    <TestTfmsInParallel>true</TestTfmsInParallel>
    <_MSTestResultsDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'MSTestResults'))</_MSTestResultsDir>
    <VSTestLogger>trx%3bLogFileName=$(_MSTestResultsDir)$(MSBuildProjectName)-$(TargetFramework).trx;html%3bLogFileName=$(_MSTestResultsDir)result-$(TargetFramework).html</VSTestLogger>
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>opencover,json</CoverletOutputFormat>
    <CoverletOutput>./CoverletOutput/</CoverletOutput>
    <Include>[Eigenverft.NetLib.SerilogRelay]*</Include>
    <ExcludeByFile>**/obj/**/System.Text.Json.SourceGeneration/**/*.cs</ExcludeByFile>
    <Threshold>100</Threshold>
    <ThresholdType>line,branch,method</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Eigenverft.NetLib.SerilogRelay.Tests/*.cs" Link="%(Filename)%(Extension)" />
    <ProjectReference Include="../Eigenverft.NetLib.SerilogRelay/Eigenverft.NetLib.SerilogRelay.csproj" SkipGetTargetFrameworkProperties="true">
      <SetTargetFramework>TargetFramework=netstandard2.1</SetTargetFramework>
    </ProjectReference>
    <AssemblyMetadata Include="TestLibraryTargetFramework" Value="netstandard2.1" />
    <!-- Restore selects the native nearest TFM; explicitly carry the forced Standard asset's extra dependencies. -->
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Version="8.0.0" />
    <PackageReference Include="StandardSocketsHttpHandler" Version="2.2.0.10" />
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.2" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
    <PackageReference Include="coverlet.msbuild" Version="10.0.1" PrivateAssets="all" />
  </ItemGroup>
</Project>
